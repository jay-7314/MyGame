  m_Script: {fileID: 11500000, guid: b856280d1f4a0d84da3d207b42a3841f, type: 3}
  m_Name: Question3_HowtoBattle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uADF8\uB7F0\uB370 \uC804\uD22C\uB77C\uB1E8? \uC800\uB294 \uC2F8\uC6B8\uC904\uB3C4
      \uBAA8\uB974\uB294\uB370.."
    choices: []
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uC2F8\uC6B8\uC904\uB3C4 \uBAA8\uB974\uB294 \uB140\uC11D\uC774
      \uC5EC\uAE30\uB294 \uC5B4\uB5BB\uAC8C \uB4E4\uC5B4\uC654\uC5B4!!\n\uADF8\uB798\uB3C4
      \uAC71\uC815\uD558\uC9C0\uB9C8. \uBB54\uAC00 \uC2E0\uAE30\uD55C \uB140\uC11D\uC774
      \uCC28\uADFC\uCC28\uADFC \uC54C\uB824\uC900\uB2E4\uACE0 \uD558\uB354\uB77C"
    choices: []
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC2E0\uAE30\uD55C \uB140\uC11D? \uADF8\uB140\uC11D\uC740 \uBB54\uB370\uC694?"
    choices: []
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uAC8C\uC784\uC744 \uD55C\uBC88 \uD574\uBD10. \uB098\uD0C0\uB098\uC9C0
      \uC54A\uC744\uAE4C \uC2F6\uC740\uB370?\n\uC8FC\uBCC0\uC5D0 \uAE38 \uAC00\uB358
      \uC0AC\uB78C\uB4E4\uC774 \uD2B9\uC774\uD55C \uB140\uC11D\uC774 \uC788\uB2E4\uACE0
      \uB9D0\uD558\uB354\uB77C\uACE0"
    choices: []
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "(\uC544\uC800\uC528 \uD55C\uBA85\uBC16\uC5D0 \uC5C6\uC73C\uBA74\uC11C
      \uC8FC\uBCC0\uC0AC\uB78C\uC774\uB77C\uB2C8.. \uD5C8\uC5B8\uC99D\uC774 \uC2EC\uD558\uC2DC\uB124..)"
    choices: []
