  m_Script: {fileID: 11500000, guid: b856280d1f4a0d84da3d207b42a3841f, type: 3}
  m_Name: Dialogue_PlayerFirst
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC544\uC624.. \uC5EC\uAE34\uB610 \uC5B4\uB514\uC57C..\n\uC65C\uC774\uB9AC
      \uC5B4\uB450\uCEF4\uCEF4\uD574. \n\uB0B4 \uD578\uB4DC\uD3F0\uC740 \uB610 \uC5B4\uB514\uC788\uACE0"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uAD50\uBCF5\uC785\uACE0 \uC790\uBA74 \uC5C4\uB9C8\uD55C\uD14C
      \uD63C\uB098\uB294\uB370?\n\uC544.. \uB4A4\uC5D0 \uB108\uBB34 \uAC70\uCD94\uC7A5\uD55C\uAC70.."
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "<size=60>\uC774\uAC8C\uBB50\uC57C!!!!!!!!!!!!</size>"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC65C \uB4F1\uB4A4\uC5D0 \uAC80\uC774 \uC788\uB294\uAC70\uC57C!!!!!!!!"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC5B4\uD6C4.. \uC77C\uB2E8 \uC6C0\uC9C1\uC5EC\uBCF4\uC790 "
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC5B4\uC774!! \uD578\uB4DC\uD3F0\uC73C\uB85C \uBCF4\uACE0 \uC788\uB294
      \uC0AC\uB78C\uB4E4~~ \uC88C\uC6B0 \uBC84\uD2BC\uC73C\uB85C \uB0A0 \uC6C0\uC9C1\uC5EC\uC918 "
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC77C\uB2E8 \uC800\uAE30 \uBC30\uBD88\uB69D\uC774 \uC544\uC800\uC528\uD55C\uD14C
      \uAC00\uBCF4\uC790\uACE0.. \uC544\uC528.. \uADC0\uCC2E\uC544\uC9C0\uB294\uB370.. "
