  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b856280d1f4a0d84da3d207b42a3841f, type: 3}
  m_Name: Dialogue_Player_NPC
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uC5B4\uD6C4.. \uAC1C\uBC1C\uC790\uB188\uC774.. \uC0B4\uB3C4 \uC548\uBE60\uC9C0\uB294\uB370
      \uACC4\uC18D \uC6C0\uC9C1\uC774\uAC8C\uB9CC \uB9CC\uB4E4\uC5C8\uB124"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC544\uC800\uC528~ \uB9D0\uC500\uC880 \uC5EC\uCB64\uBCFC\uAC8C\uC694!!
      \uC5EC\uAE30\uB294.."
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uBB50\uC57C. \uD559\uC0DD\uC774\uC57C? \uBB54\uC9D3\uC744 \uD588\uAE38\uB798
      \uC5EC\uAE30\uB85C \uC628\uAC70\uB0D0? \uC544.. \uB610 \uADC0\uCC2E\uC544\uC8FC\uACA0\uB124..\n\uC774\uBC88\uC774
      \uBA87\uBC88\uC9F8\uC57C"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uB124? \uADF8\uAC8C \uBB34\uC2A8\uB9D0\uC500\uC774\uC2DC\uC8E0?"
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uB108 \uC9C0\uAE08 \uBCF5\uC7A5\uC744 \uBD10\uB77C. \uAD50\uBCF5
      \uC544\uB2C8\uB0D0? \uB204\uAC00\uBD10\uB3C4 \uD559\uC0DD\uC778\uAC70 \uB531
      \uC54C\uACA0\uAD6C\uB9CC"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uB124. \uD559\uC0DD\uC778\uAC74 \uB9DE\uB294\uB370...(\uD654\uAC00
      \uB9CE\uC774 \uC788\uB294 \uC544\uC800\uC528\uC778\uAC00 \uBCF4\uB2E4)"
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uB108 \uB0B4\uAC00 \uD654\uAC00 \uB9CE\uC774 \uC788\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uC9C0? \uB098\uB294 \uB108\uAC19\uC740 \uB140\uC11D\uC744
      \uC9C0\uAE08 \uBC8C\uC368 100\uBA85\uB3C4 \uB118\uAC8C \uB9CC\uB0AC\uC5B4\n\uADF8
      \uC774\uD6C4\uC5D0\uB294 \uC138\uC9C0\uB3C4 \uC54A\uC558\uC73C\uB2C8 \uD6E8\uC52C
      \uB9CE\uACA0\uC9C0"
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uADF8\uB798\uB3C4.. \uC804 \uCC98\uC74C\uC778\uB370.. \uD639\uC2DC
      \uC798 \uC54C\uB824\uC8FC\uC2E4\uC218 \uC788\uC73C\uC2E4\uAE4C\uC694? "
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uADF8\uB798\uB3C4 \uB10C \uC870\uAE08 \uC2F9\uC218\uAC00 \uC788\uC5B4\uBCF4\uC774\uB124?
      \uC624\uCF00\uC774! \uAE30\uBD84\uC774\uB2E4! \uB2E4 \uBB3C\uC5B4\uBD10"
