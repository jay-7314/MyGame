  m_Script: {fileID: 11500000, guid: b856280d1f4a0d84da3d207b42a3841f, type: 3}
  m_Name: Question2_howManyOutPeoples
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uD639\uC2DC\uB098 \uD558\uACE0 \uBB3C\uC5B4\uBCF4\uB294\uB370..\n\uC5EC\uAE30\uC11C
      \uB098\uAC04 \uC0AC\uB78C\uC740 \uC788\uC5B4\uC694?"
    choices: []
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uC5B4.. \uC606\uC9D1 \uB538\uB0B4\uBBF8\uB791.. \uC6B0\uB9AC
      \uC544\uB4E4\uC774\uB791..\n\uC5C6\uC744\uAEC4? \uC77C\uB2E8 \uB0B4\uAC00 \uC54C\uAE30\uB85C\uB294
      \uC5C6\uC5B4"
    choices: []
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uADF8\uAC8C \uBB34\uC2A8\uC18C\uB9AC\uC5D0\uC694? \uAF2D \uC788\uC744\uAEBC\uAC19\uC774
      \uC774\uC57C\uAE30 \uD558\uB354\uB2C8..\n\uC606\uC9D1? \uC544\uB4E4? \uC774\uAC74
      \uBB34\uC2A8\uC774\uC57C\uAE30\uC5D0\uC694??"
    choices: []
  - speaker: {fileID: 11400000, guid: e2ba7739d3b3bea4d8133928e4d2ccb8, type: 2}
    dialogueText: "\uADF8\uB0E5 \uBA87\uC77C\uC804 \uC560\uB4E4\uC774 \uACB0\uD63C\uD55C\uAC8C
      \uC0DD\uAC01\uB098\uC11C \u314E\u314E\n\uB108\uAC00 \uCC98\uC74C\uC73C\uB85C
      \uD574\uC11C \uB098\uAC00\uBD10 \uADF8\uB7EC\uBA74 \uBB54\uAC00 \uBC14\uB00C\uC9C0
      \uC54A\uACA0\uC5B4?"
    choices: []
