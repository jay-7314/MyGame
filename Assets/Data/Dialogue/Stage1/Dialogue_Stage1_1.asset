  lines:
  - speaker: {fileID: 11400000, guid: 975027ddc50f1ec41aed4395f892cc38, type: 2}
    dialogueText: "\uB108\uC5D0\uAC8C \uB4DC\uB514\uC5B4 \uCCAB \uC2A4\uD14C\uC774\uC9C0\uC774\uACA0\uB124? "
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uBB50\uC57C? \uB204\uAD6C\uC57C? \uB204\uAD70\uB370 \uB098\uD55C\uD14C
      \uB9D0\uC744 \uAC70\uB294\uAC70\uC57C"
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 975027ddc50f1ec41aed4395f892cc38, type: 2}
    dialogueText: "\uB9C8\uC744\uC5D0\uC11C \uB4E3\uC9C0 \uBABB\uD588\uC5B4? \uB108\uB97C
      \uB3C4\uC640\uC8FC\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0 \uD588\uC796\uC544."
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 975027ddc50f1ec41aed4395f892cc38, type: 2}
    dialogueText: "\uB9C8\uC744\uC5D0\uC11C \uB4E3\uC9C0 \uBABB\uD588\uC5B4? \uB108\uB97C
      \uB3C4\uC640\uC8FC\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0 \uD588\uC796\uC544."
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uB108\uAC00 \uB098\uB97C \uBB58 \uB3C4\uC640\uC900\uB2E4\uB294\uAC70\uC57C?\n\uADF8\uB9AC\uACE0
      \uAC11\uC790\uAE30 \uC804\uD22C\uB77C\uB2C8.."
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 975027ddc50f1ec41aed4395f892cc38, type: 2}
    dialogueText: "\uB9C8\uC744\uC5D0\uC11C \uCE7C\uC9C8\uD558\uACE0 \uC810\uD504\uD558\uACE0
      \uBCC4\uC9D3\uC744 \uB2E4\uD558\uB354\uB2C8?\n\uC774\uBC88\uC5D4 \uC65C \uB610
      \uC57D\uD55C\uCC99 \uD558\uACE0 \uC788\uB0D0? "
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uB108\uAC19\uC73C\uBA74 \uAC11\uC790\uAE30 \uB098\uC624\uBA74
      \uC548\uBB34\uC12D\uACA0\uB0D0?  "
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: f5872cd84883ffb4d97d10c3c28c6067, type: 2}
    dialogueText: "\uCF08\uCF08\uCF08... "
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uC800\uAC70 \uBD10\uBD10.. \uAC11\uC790\uAE30 \uC5C4\uCCAD \uBB34\uC11C\uC6B4
      \uD574\uACE8\uC774 \uB098\uC624\uC796\uC544 "
    choices: []
    isNextScene: 0
  - speaker: {fileID: 11400000, guid: 9ccbf00547b03df46903e60a1c9b9321, type: 2}
    dialogueText: "\uB9C8\uC744\uC5D0\uC11C \uD55C\uAC83\uCC98\uB7FC \uC800\uAC83\uB3C4
      \uC370\uC5B4\uBD10 "
    choices: []
    isNextScene: 0
